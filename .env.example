# Optional. Leave OPENAI_API_KEY empty to run fully offline with labelled sample data.
OPENAI_API_KEY=

# OpenAI-compatible endpoint (e.g. https://api.openai.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# Any chat-completions model available on that endpoint.
OPENAI_MODEL=gpt-4o-mini

# auto = use the LLM when a key exists, otherwise sample data
# sample = always offline sample data; llm = require a key
RESEARCH_MODE=auto

# Optional hybrid web search for research queries (small talk still uses chat LLM).
# SEARCH_PROVIDER=auto|tavily|none
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
